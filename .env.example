# Copy to .env on the server and fill as needed.
#
# Upstream OpenAI-compatible endpoint (your proxy)
API_BASE=https://grok.anlonely.me/v1

# Optional if your proxy allows anonymous requests.
API_KEY=

# Optional; only needed for /v1/admin/tokens checks. App will still run without it.
ADMIN_API_KEY=

# Optional application login. Leave SITE_AUTH_PASSWORD empty to disable locally.
SITE_AUTH_USERNAME=novel
SITE_AUTH_PASSWORD=
SITE_AUTH_SECRET=
SITE_AUTH_SESSION_DAYS=30

# Model defaults
DEFAULT_MODEL=grok-4.20-auto
MODEL_FALLBACK_ORDER=grok-4.20-auto,grok-4.20-fast,grok-4.20-expert

# Optional tuning
CONSERVE_REQUESTS=true

# Skip chapters that do not look worth expanding.
SKIP_IF_NO_CONTENT=true

# Detection strategy: romance_or_omission, omission_only, always.
EXPANSION_CHECK_MODE=romance_or_omission
